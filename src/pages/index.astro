---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header/Header.jsx';
import Profile from '../components/Profile/Profile.jsx';
import PersonalDescription from '../components/PersonalDescription/PersonalDescription.jsx';
import Editor from '../components/editor.jsx';
import JobHistory from '../components/JobHistory/JobHistory.jsx';
import Projects from '../components/Projects/Projects.jsx';
---
<Layout>
  <div class="web-content">
    <Header client:load />
    <div id="home" class="xl-flex section">
      <div class="col hero-col reveal">
        <Profile />
      </div>
      <div class="col hero-col reveal" style="transition-delay: 0.15s">
        <div class="editor-glass-wrapper">
          <Editor client:only="react" />
        </div>
      </div>
    </div>
    <section id="about" class="section about-section">
      <div class="about-left">
        <h1 class="section-title about-title">About</h1>
      </div>
      <div class="about-right reveal">
        <PersonalDescription />
      </div>
    </section>
    <JobHistory />
    <Projects />
  </div>
</Layout>

<style>
  .hero-col {
    align-items: flex-start;
    justify-content: flex-start;
  }

  .hero-col:first-child {
    flex: 0 0 260px;
  }

  .hero-col:last-child {
    flex: 1;
    min-width: 0;
  }

  .editor-glass-wrapper {
    border-radius: var(--apple-radius);
    overflow: hidden;
    box-shadow: var(--apple-shadow);
  }

  .hero-col:last-child {
    align-items: center;
  }

  .about-section {
    display: flex;
    gap: 4rem;
    align-items: flex-start;
  }

  .about-left {
    flex: 0 0 240px;
  }

  .about-title {
    margin-top: 0.5rem;
  }

  .about-right {
    flex: 1;
    min-width: 0;
  }
</style>
